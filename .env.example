# MagicBlock Private Payments API — HTTP base (no trailing slash). Devnet endpoints come from your deployment / docs.
# Example placeholder only (requests will fail DNS): https://api.example.invalid
PER_PRIVATE_PAYMENT_BASE_URL=https://api.example.invalid

# Back-compat alias read by @private-mpp/per-client if PER_PRIVATE_PAYMENT_BASE_URL is unset
# PER_API_BASE=

# Next.js public config (safe for browser bundles)
NEXT_PUBLIC_APP_NAME=PrivateMPP

# signing / MPP x402 credential verification — generate securely; never commit real values
MPP_SECRET_KEY=replace-with-long-random-secret

# Tempo rail for apps/web example-paid route — TIP-20 currency + recipient per https://docs.tempo.xyz/guide/machine-payments/server ("Currency and recipient values").
# PathUSD predeploy: https://docs.tempo.xyz/quickstart/predeployed-contracts — replace recipient with your own address for real credits.
MPP_TEMPO_CURRENCY=0x20c0000000000000000000000000000000000000
MPP_TEMPO_RECIPIENT=0xa726a1CD723409074DF9108A2187cfA19899aCF8

# OpenRouter — chat/agent API (https://openrouter.ai/). Document-only in repo.
OPENROUTER_API_KEY=sk-or-v1-replace

# Optional default model for agent smoke tests
OPENROUTER_MODEL=openai/gpt-4o-mini

# Solana cluster hint for tooling (devnet-first)
SOLANA_NETWORK=devnet
